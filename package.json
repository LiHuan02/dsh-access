{
  "name": "dsh-access",
  "version": "0.2.0",
  "description": "Access: encrypted credentials, connectors, and sidebar browser automation for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "author": "dsh-access contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiHuan02/dsh-access.git"
  },
  "homepage": "https://github.com/LiHuan02/dsh-access",
  "bugs": {
    "url": "https://github.com/LiHuan02/dsh-access/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node tests/compat.check.mjs && node tests/connectors.check.mjs && node tests/approval.check.mjs && node tests/browser-setup.check.mjs && node tests/bridge.check.mjs && node tests/unit.check.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "credentials",
    "password-manager",
    "connectors",
    "browser-automation",
    "cdp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "18.3.12",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0"
  }
}
